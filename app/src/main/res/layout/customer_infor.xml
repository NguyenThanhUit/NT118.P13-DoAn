<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <ImageButton
        android:id="@+id/ic_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_back"
        android:backgroundTint="@color/background"
        android:background="@color/background" />
    <TextView
        android:id="@+id/tv_customer_infor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer information"
        android:textStyle="bold"
        android:textSize="21sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageButton
        android:id="@+id/ic_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_edit"
        android:background="@color/background"
        android:backgroundTint="@color/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_customer_infor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/border_background"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/ic_edit">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/avatar"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:id="@+id/tv_customer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer name"
            app:layout_constraintStart_toEndOf="@id/avatar_image"
            android:textSize="21sp"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/tv_phone_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone number: "
            app:layout_constraintStart_toEndOf="@id/avatar_image"
            app:layout_constraintTop_toBottomOf="@id/tv_customer_name"/>
        <TextView
            android:id="@+id/tv_customer_phone_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[0123456789]"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tv_phone_number"
            app:layout_constraintTop_toTopOf="@id/tv_phone_number"/>
        <TextView
            android:id="@+id/tv_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: "
            app:layout_constraintStart_toEndOf="@id/avatar_image"
            app:layout_constraintTop_toBottomOf="@id/tv_phone_number"/>
        <TextView
            android:id="@+id/tv_customer_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[abcdef@gmail.com]"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tv_email"
            app:layout_constraintTop_toTopOf="@id/tv_email"/>
        <TextView
            android:id="@+id/tv_adress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adress: "
            app:layout_constraintStart_toEndOf="@id/avatar_image"
            app:layout_constraintTop_toBottomOf="@id/tv_email"/>
        <TextView
            android:id="@+id/tv_customer_adress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Ho Chi Minh City]"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tv_adress"
            app:layout_constraintTop_toTopOf="@id/tv_adress"/>
        <TextView
            android:id="@+id/tv_incharge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Person in charge: "
            app:layout_constraintStart_toEndOf="@id/avatar_image"
            app:layout_constraintTop_toBottomOf="@id/tv_adress"/>
        <TextView
            android:id="@+id/tv_employee_incharge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Phan Duy Tho]"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tv_incharge"
            app:layout_constraintTop_toTopOf="@id/tv_incharge"/>
        <TextView
            android:id="@+id/tv_class"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer class: "
            app:layout_constraintStart_toEndOf="@id/avatar_image"
            app:layout_constraintTop_toBottomOf="@id/tv_incharge"/>
        <TextView
            android:id="@+id/tv_customer_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Potential]"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tv_class"
            app:layout_constraintTop_toTopOf="@id/tv_class"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageButton
            android:id="@+id/ic_call"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_call"
            android:background="@drawable/circle_icon_background"
            android:gravity="center"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/cl_customer_infor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ic_mail"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Call phone"
        android:textSize="18sp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@id/ic_call"
        app:layout_constraintEnd_toEndOf="@id/ic_call"
        app:layout_constraintTop_toBottomOf="@id/ic_call"/>
        <ImageButton
            android:id="@+id/ic_mail"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_mail"
            android:background="@drawable/circle_icon_background"
            android:gravity="center"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/cl_customer_infor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send email"
        android:textSize="18sp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@id/ic_mail"
        app:layout_constraintEnd_toEndOf="@id/ic_mail"
        app:layout_constraintTop_toBottomOf="@id/ic_mail"/>
    <ImageButton
        android:id="@+id/ic_note"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_note"
        android:background="@drawable/circle_icon_background"
        android:gravity="center"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/cl_customer_infor"
        app:layout_constraintStart_toEndOf="@id/ic_mail"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add note"
        android:textSize="18sp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@id/ic_note"
        app:layout_constraintEnd_toEndOf="@id/ic_note"
        app:layout_constraintTop_toBottomOf="@id/ic_note"/>
</androidx.constraintlayout.widget.ConstraintLayout>