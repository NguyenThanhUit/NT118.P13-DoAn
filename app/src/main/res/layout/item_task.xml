<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="task"
            type="com.example.doan.tasks.Tasks" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="150sp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rounded_list_item"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Task ID"
            android:text="@{task.taskID}"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Status"
            android:text="@{task.taskStatus}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_task_title" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/green_light"
            android:hint="Start - End"
            android:paddingEnd="20sp"
            android:text='@{"Start: " + task.taskAssignedDate + " - End: " + task.taskDueDate}'
            android:textSize="20sp"

            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/tv_status"
            tools:layout_editor_absoluteX="16dp"></TextView>

        <ImageButton
            android:id="@+id/ib_delete_task"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/secondary"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="@+id/tv_status"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
