<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
        <TextView
            android:id="@+id/tv_customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customers"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_customer_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/TextInputStyle"
            app:layout_constraintTop_toBottomOf="@id/tv_customer">
            <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search customer name">
            </com.google.android.material.textfield.TextInputEditText>
        </com.google.android.material.textfield.TextInputLayout>
    <HorizontalScrollView
        android:id="@+id/hs_customer_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/til_customer_search">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Filter Tag "Tất Cả" -->
            <TextView
                android:id="@+id/tv_customer_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border_listview_setting"
                android:text="Tất cả"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:gravity="center"/>

            <!-- Filter Tag "Chưa tiếp Cận" -->
            <TextView
                android:id="@+id/tv_customer_filter_uncontacted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border_listview_setting"
                android:text=" Chưa tiếp cận"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:drawableLeft="@drawable/ic_square_orange" />

            <!-- Filter Tag "Tiếp Cận" -->
            <TextView
                android:id="@+id/tv_customer_filter_contacted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border_listview_setting"
                android:text=" Tiếp cận"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:drawableLeft="@drawable/ic_square_green"/>
            <!-- Filter Tag "Tiềm Năng" -->
            <TextView
                android:id="@+id/tv_customer_filter_potential"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border_listview_setting"
                android:text=" Tiềm năng"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:drawableLeft="@drawable/ic_square_golden"/>
            <!-- Filter Tag "Nóng" -->
            <TextView
                android:id="@+id/tv_customer_filter_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border_listview_setting"
                android:text=" Chốt"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:drawableLeft="@drawable/ic_square_red"/>

            <!-- Filter Tag "Thất bại" -->
            <TextView
                android:id="@+id/tv_customer_filter_failure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border_listview_setting"
                android:text=" Thất bại"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:drawableLeft="@drawable/ic_square_gray" />

        </LinearLayout>
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_customer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/hs_customer_filter">
        </androidx.recyclerview.widget.RecyclerView>
        <ImageButton
            android:id="@+id/ib_customer_add"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/rounded_corner"
            android:layout_marginBottom="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
        </ImageButton>

</androidx.constraintlayout.widget.ConstraintLayout>