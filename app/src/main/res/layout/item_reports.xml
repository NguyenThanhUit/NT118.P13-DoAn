<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_list_item"
    android:padding="16dp"
    android:layout_marginBottom="10dp">
    <TextView
        android:id="@+id/tv_report_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Report Title"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <TextView
        android:id="@+id/tv_report_create_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[Create date]"
        app:layout_constraintTop_toBottomOf="@+id/tv_report_title"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/tv_dash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" - "
        app:layout_constraintStart_toEndOf="@+id/tv_report_create_date"
        app:layout_constraintEnd_toStartOf="@id/tv_report_due_date"
        app:layout_constraintTop_toTopOf="@id/tv_report_due_date"
        />
    <TextView
        android:id="@+id/tv_report_due_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[Due date]"
        app:layout_constraintTop_toBottomOf="@+id/tv_report_title"
        app:layout_constraintStart_toEndOf="@id/tv_dash"/>

</androidx.constraintlayout.widget.ConstraintLayout>