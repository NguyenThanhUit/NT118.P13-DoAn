<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="clickHandler"
            type="com.example.doan.tasks.AddNewTaskClick" />
        <variable
            name="task"
            type="com.example.doan.tasks.Tasks" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="50dp"
            android:paddingHorizontal="16dp"
            tools:context=".ui.createTask">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/ic_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_back"
                    android:backgroundTint="@color/background"
                    android:background="@color/background" />
                <TextView
                    android:id="@+id/tv_create_task"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Create Task"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="24sp" />
            </LinearLayout>




            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nhân viên"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/spinnerEmployeeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_white"
                android:padding="8dp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mô tả nhiệm vụ"
                android:textSize="16sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/taskDescription"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:padding="5dp"
                android:background="@drawable/border_white"
                android:hint="Nhập mô tả nhiệm vụ"
                android:text="@={task.taskDecription}" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ngày giao"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvAssignDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:padding="5dp"
                    android:layout_gravity="center"
                    android:background="@drawable/border_white"
                    android:text="@{task.taskAssignedDate != null ? task.taskAssignedDate : `Chưa chọn ngày giao`}"
                    android:textColor="@color/black"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btnAssignDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pick"
                    android:layout_gravity="center"
                    style="@style/ButtonStyle"
                    android:onClick="@{clickHandler::onAssignDateClicked}" />
            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ngày hết hạn"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvDueDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:padding="5dp"
                    android:layout_gravity="center"
                    android:background="@drawable/border_white"
                    android:text="@{task.taskDueDate != null ? task.taskDueDate : `Chưa chọn ngày hết hạn`}"
                    android:textColor="@color/black"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btnDueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pick"
                    android:layout_gravity="center"
                    style="@style/ButtonStyle"
                    android:onClick="@{clickHandler::onDueDateClicked}" />
            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ghi chú"
                android:textSize="16sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/taskNotes"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:hint="Nhập ghi chú"
                android:padding="5dp"
                android:background="@drawable/border_white"
                android:text="@={task.taskNotes}" />


            <Button
                style="@style/ButtonStyle"
                android:onClick="@{clickHandler::onSubmitBtnClicked}"
                android:id="@+id/assignTaskButton"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_gravity="center"
                android:text="Assign Task" />

        </LinearLayout>
    </ScrollView>

</layout>
