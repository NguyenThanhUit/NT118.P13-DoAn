<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ImageButton
        android:id="@+id/ic_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_back"
        android:backgroundTint="@color/background"
        android:background="@color/background" />

    <ImageButton
        android:id="@+id/ic_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_edit"
        android:background="@color/background"
        android:backgroundTint="@color/background"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Task Title -->
    <TextView
        android:id="@+id/tv_task_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Task title"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ic_back" />

    <!-- Task ID -->
    <TextView
        android:id="@+id/tv_task_id_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Task ID"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_task_title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_task_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Task ID"
        android:gravity="start"
        app:layout_constraintTop_toBottomOf="@id/tv_task_id_label"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Task Direction -->
    <TextView
        android:id="@+id/tv_task_direction_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Task to"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_task_id"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_task_direction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nguyễn Văn A"
        android:gravity="start"
        app:layout_constraintTop_toBottomOf="@id/tv_task_direction_label"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Created Date -->
    <TextView
        android:id="@+id/tv_task_start_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Created date"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_task_direction" />

    <TextView
        android:id="@+id/tv_task_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MM/DD/YYYY"
        android:gravity="start"
        app:layout_constraintTop_toBottomOf="@id/tv_task_start_label"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- End Date -->
    <TextView
        android:id="@+id/tv_task_end_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="End date"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_task_start" />

    <TextView
        android:id="@+id/tv_task_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MM/DD/YYYY"
        android:gravity="start"
        app:layout_constraintTop_toBottomOf="@id/tv_task_end_label"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Description -->
    <TextView
        android:id="@+id/tv_task_description_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Description"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_task_end"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_task_description"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="start|top"
        android:text="Enter task description here"
        app:layout_constraintTop_toBottomOf="@id/tv_task_description_label"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
