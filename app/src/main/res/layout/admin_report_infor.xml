<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    >

    <ImageButton
        android:id="@+id/ic_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_back"
        android:backgroundTint="@color/background"
        android:background="@color/background"/>
    <ImageButton
        android:id="@+id/ic_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_edit"
        android:background="@color/background"
        android:backgroundTint="@color/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_reports"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reports"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_report_infor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/border_background"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/tv_reports">
        <TextView
            android:id="@+id/tv_report_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report title 1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/tv_report_start_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[DD/MM/YYYY]"
            app:layout_constraintTop_toBottomOf="@id/tv_report_title"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:id="@+id/tv_dash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "
            app:layout_constraintStart_toEndOf="@id/tv_report_start_date"
            app:layout_constraintTop_toTopOf="@id/tv_report_start_date"/>
        <TextView
            android:id="@+id/tv_report_end_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[DD/MM/YYYY]"
            app:layout_constraintTop_toBottomOf="@id/tv_report_title"
            app:layout_constraintStart_toEndOf="@id/tv_dash"/>
        <TextView
            android:id="@+id/tv_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reported by: "
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_report_start_date"/>
        <TextView
            android:id="@+id/tv_report_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Username]"
            app:layout_constraintTop_toTopOf="@id/tv_author"
            app:layout_constraintStart_toEndOf="@id/tv_author"/>
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_author"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_description"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:layout_constraintTop_toBottomOf="@id/tv_description">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="start|top"
                android:hint="Enter task description here"
                android:inputType="textMultiLine"
                android:background="@drawable/border_listview_setting"
                />
        </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>