<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingTop="50dp">
    <ImageButton
        android:id="@+id/ic_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_back"
        android:backgroundTint="@color/background"
        android:background="@color/background" />

    <ImageButton
        android:id="@+id/ic_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="656dp"
        android:layout_marginEnd="8dp"
        android:background="@color/background"
        android:backgroundTint="@color/background"
        android:src="@drawable/ic_check"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_create_report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit report"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/tv_report_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Title"
        android:textSize="18sp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_create_report"
        app:layout_constraintStart_toStartOf="parent" />
    <EditText
        android:id="@+id/et_report_title"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/border_listview_setting"
        app:layout_constraintTop_toBottomOf="@id/tv_report_title" />
    <TextView
        android:id="@+id/tv_report_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start date"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_report_title" />
    <EditText
        android:id="@+id/et_report_start"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:inputType="date"
        android:background="@drawable/border_listview_setting"
        app:layout_constraintTop_toBottomOf="@id/tv_report_start" />
    <TextView
        android:id="@+id/tv_report_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="End date"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_report_start" />
    <EditText
        android:id="@+id/et_report_end"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:inputType="date"
        android:background="@drawable/border_listview_setting"
        app:layout_constraintTop_toBottomOf="@id/tv_report_end" />
    <TextView
        android:id="@+id/tv_report_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Description"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/et_report_end"
        app:layout_constraintStart_toStartOf="parent" />
    <EditText
        android:id="@+id/et_report_description"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="start|top"
        android:background="@drawable/border_listview_setting"
        android:inputType="textMultiLine"
        app:layout_constraintTop_toBottomOf="@id/tv_report_description" />
</androidx.constraintlayout.widget.ConstraintLayout>