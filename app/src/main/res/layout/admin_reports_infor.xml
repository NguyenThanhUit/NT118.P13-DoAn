<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingTop="50dp">

    <!-- Nút quay lại -->
    <ImageButton
        android:id="@+id/ic_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_back"
        android:backgroundTint="@color/background"
        android:background="@color/background" />

    <ImageButton
        android:id="@+id/ic_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_edit"
        android:background="@color/background"
        android:backgroundTint="@color/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Tiêu đề "Reports" -->
    <TextView
        android:id="@+id/tv_reports"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reports"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Container hiển thị thông tin báo cáo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_report_infor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/border_background"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/tv_reports">

        <!-- Tiêu đề báo cáo -->
        <TextView
            android:id="@+id/tv_report_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report Title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Ngày bắt đầu -->
        <TextView
            android:id="@+id/tv_report_start_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Date: [DD/MM/YYYY]"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_report_title"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Ngày kết thúc -->
        <TextView
            android:id="@+id/tv_report_end_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End Date: [DD/MM/YYYY]"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_report_start_date"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Tác giả -->
        <TextView
            android:id="@+id/tv_report_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reported by: [Username]"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_report_end_date"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Mô tả -->
        <TextView
            android:id="@+id/tv_report_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description: [Description of the report]"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_report_author"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>