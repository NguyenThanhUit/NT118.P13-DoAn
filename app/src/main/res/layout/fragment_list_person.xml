<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="clickHandler"
            type="com.example.doan.customers.CustomerClickHandler" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context=".ListPersonFragment"
        android:paddingHorizontal="16dp">

        <!-- Layout chứa tiêu đề và các bộ lọc -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title TextView -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Customer"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Filter Section -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:text="Tất cả"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/white"
                        android:elevation="4dp" />

                    <Button
                        android:id="@+id/btnFilterNew"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:text="Mới"
                        android:drawableLeft="@drawable/ic_square_blue"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/white"
                        android:elevation="4dp" />

                    <Button
                        android:id="@+id/btnFilterNotApproach"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:text="Chưa tiếp cận"
                        android:drawableLeft="@drawable/ic_square_orange"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/white"
                        android:elevation="4dp" />

                    <Button
                        android:id="@+id/btnFilterApproach"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:text="Tiếp cận"
                        android:drawableLeft="@drawable/ic_square_green"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/white"
                        android:elevation="4dp" />

                    <Button
                        android:id="@+id/btnFilterHot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:text="Nóng"
                        android:textColor="@color/black"
                        android:drawableLeft="@drawable/ic_square_red"
                        android:backgroundTint="@color/white"
                        android:elevation="4dp" />

                    <Button
                        android:id="@+id/btnFilterPotential"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:text="Tiềm năng"
                        android:textColor="@color/black"
                        android:drawableLeft="@drawable/ic_square_golden"
                        android:backgroundTint="@color/white"
                        android:elevation="4dp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerLayout"
            android:layout_marginTop="-3dp"
            tools:listitem="@layout/customer_list_item" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:onClick="@{clickHandler::onFABClicked}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="30dp"
            app:srcCompat="@drawable/ic_add_white"
            app:tint="@color/white"
            android:backgroundTint="@color/accent"
            app:fabSize="normal" />
    </RelativeLayout>
</layout>
