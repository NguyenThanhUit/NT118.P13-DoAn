<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">#1E2022</item> <!-- Màu nền -->
        <item name="android:textColor">#FFFFFF</item> <!-- Màu chữ -->
        <item name="cornerFamily">rounded</item> <!-- Bo góc -->
        <item name="cornerRadius">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:height">50dp</item>
    </style>
    <style name="TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="strokeColor">#000000</item> <!-- Màu viền -->
        <item name="backgroundTint">#F0F5F9</item> <!-- Màu nền khi chưa nhấn vào-->
        <item name="android:textColorHint">#52616B</item> <!-- Màu chữ hint -->
        <item name="android:textColor">#000000</item> <!-- Màu chữ -->
        <item name="boxCornerRadiusTopStart">8dp</item> <!-- Bo góc -->
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="EditTextStyle" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="backgroundTint">#F0F5F9</item> <!-- Màu nền khi chưa nhấn vào-->
    </style>
</resources>