<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background" /> <!-- Màu nền khi nhấn -->
            <stroke android:width="1dp" android:color="@color/black" /> <!-- Viền khi nhấn -->
            <corners android:radius="8dp" /> <!-- Bo góc -->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" /> <!-- Màu nền bình thường -->
            <stroke android:width="1dp" android:color="@color/black" /> <!-- Viền bình thường -->
            <corners android:radius="8dp" /> <!-- Bo góc -->
        </shape>
    </item>
</selector>
